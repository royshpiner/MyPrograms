class Question {
    field String text;
    field Array answers;
    field int correctIndex;

    constructor Question new(String questionText, Array ans, int correct) {
        let text = questionText;

        let answers = Array.new(4); // constant amount of possible answers for each question: 4
        let answers[0] = ans[0]; // answer 1
        let answers[1] = ans[1]; // answer 2
        let answers[2] = ans[2]; // answer 3
        let answers[3] = ans[3]; // answer 4

        let correctIndex = correct;
        return this;
    }

    // method to retrieve question
    method String getQuestion() {
        return text;
    }

    // workaround for deleting an asked question from screen (might delete later)
    method void removeQuestion() {
        
        return;
    }

    // method to retrieve answer
    method String getAnswer(int index) { 
        return answers[index];
    }

    method int isCorrect(int index) { // check if user's answer is the correct answer
        return index = correctIndex;
    }

    // method to dispose question object
    method void dispose() {
        do answers.dispose();
        do Memory.deAlloc(this);
        return;
    }

    // 50-50: removes 2 wrong answers and keeps a random wrong answer and the correct one.
    // Recieves a random integer to get a random wrong answer to display along the correct answer.
    method void callFiftyFifty(int seed) {
        var int randomWrong, i;

        do Random.setSeed(seed);
        let randomWrong = Random.rand();

        let i = 0;
        while (i < 4) {
            if ((~(i = correctIndex)) & (~(i = randomWrong))) {
                let answers[i] = "";
                let i = i + 1;
            }
        }

        // redraw the question here? doesn't work rn.

        return;
    }

    method void callFriend(int seed) {
        // TODO: IMPLEMENT
        return;
    }

    method void callAskCrowd(int seed) {
        // TODO: IMPLEMENT
        return;
    }

}