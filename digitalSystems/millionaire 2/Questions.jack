class Questions { // ALL THE QUESTIONS ARE STORED HERE
    field Array questions; // array of questions
    field int size; // array size

    constructor Questions new() {
        let size = 10; // number of questions stored in the question list
        let questions = Array.new(size);
        do initialize();

        return this;
    }

    method void initialize() {
        //
        // LIST OPF ALL QUESTIONS
        //
        var Array qOneAnswers, qTwoAnswers, qThreeAnswers, qFourAnswers, qFiveAnswers, qSixAnswers, qSevenAnswers, qEightAnswers, qNineAnswers, 
        qTenAnswers, qElevenAnswers, qTwelveAnswers;
        var Question qOne, qTwo, qThree, qFour, qFive, qSix, qSeven, qEight, qNine, qTen, qEleven, qTwelve;

        let qOneAnswers = Array.new(4);
        let qOneAnswers[0] = "Madrid"; let qOneAnswers[1] = "Paris"; let qOneAnswers[2] = "Tel Aviv"; let qOneAnswers[3] = "Prague";
        let qOne = Question.new("What is the capital of France?", qOneAnswers, 1);
        let questions[0] = qOne;

        let qTwoAnswers = Array.new(4);
        let qTwoAnswers[0] = "Amazon"; let qTwoAnswers[1] = "Nile"; let qTwoAnswers[2] = "Yangtze"; let qTwoAnswers[3] = "Mississippi";
        let qTwo = Question.new("What is the longest river in the world?", qTwoAnswers, 1);
        let questions[1] = qTwo;

        let qThreeAnswers = Array.new(4);
        let qThreeAnswers[0] = "Cricket"; let qThreeAnswers[1] = "Basketball"; let qThreeAnswers[2] = "Soccer"; let qThreeAnswers[3] = "Tennis";
        let qThree = Question.new("Which sport is known as 'the beautiful game'?", qThreeAnswers, 2);
        let questions[2] = qThree;

        let qFourAnswers = Array.new(4);
        let qFourAnswers[0] = "100 meters"; let qFourAnswers[1] = "200 meters"; let qFourAnswers[2] = "400 meters"; let qFourAnswers[3] = "800 meters";
        let qFour = Question.new("What is Usain Bolt's primary event?", qFourAnswers, 0);
        let questions[3] = qFour;

        let qFiveAnswers = Array.new(4);
        let qFiveAnswers[0] = "Jerusalem"; let qFiveAnswers[1] = "Tel Aviv"; let qFiveAnswers[2] = "Haifa"; let qFiveAnswers[3] = "Eilat";
        let qFive = Question.new("What is the capital of Israel?", qFiveAnswers, 0);
        let questions[4] = qFive;

        let qSixAnswers = Array.new(4);
        let qSixAnswers[0] = "Dead Sea"; let qSixAnswers[1] = "Mediterranean Sea"; let qSixAnswers[2] = "Sea of Galilee"; let qSixAnswers[3] = "Red Sea";
        let qSix = Question.new("Which sea is the lowest point on Earth?", qSixAnswers, 0);
        let questions[5] = qSix;

        let qSevenAnswers = Array.new(4);
        let qSevenAnswers[0] = "Titanic"; let qSevenAnswers[1] = "Avatar"; let qSevenAnswers[2] = "The Avengers"; let qSevenAnswers[3] = "Star Wars";
        let qSeven = Question.new("Which movie has the highest box office earnings of all time?", qSevenAnswers, 1);
        let questions[6] = qSeven;

        let qEightAnswers = Array.new(4);
        let qEightAnswers[0] = "1994"; let qEightAnswers[1] = "1997"; let qEightAnswers[2] = "2001"; let qEightAnswers[3] = "1989";
        let qEight = Question.new("In which year was 'The Shawshank Redemption' released?", qEightAnswers, 0);
        let questions[7] = qEight;

        let qNineAnswers = Array.new(4);
        let qNineAnswers[0] = "1914"; let qNineAnswers[1] = "1918"; let qNineAnswers[2] = "1939"; let qNineAnswers[3] = "1945";
        let qNine = Question.new("In which year did World War II start?", qNineAnswers, 2);
        let questions[8] = qNine;

        let qTenAnswers = Array.new(4);
        let qTenAnswers[0] = "1961"; let qTenAnswers[1] = "1969"; let qTenAnswers[2] = "1971"; let qTenAnswers[3] = "1975";
        let qTen = Question.new("In which year did the first man land on the moon?", qTenAnswers, 1);
        let questions[9] = qTen;

        let qElevenAnswers = Array.new(4);
        let qElevenAnswers[0] = "Python"; let qElevenAnswers[1] = "Java"; let qElevenAnswers[2] = "C++"; let qElevenAnswers[3] = "JavaScript";
        let qEleven = Question.new("Which programming language is often used for web development?", qElevenAnswers, 3);
        let questions[10] = qEleven;

        let qTwelveAnswers = Array.new(4);
        let qTwelveAnswers[0] = "1991"; let qTwelveAnswers[1] = "1985"; let qTwelveAnswers[2] = "1975"; let qTwelveAnswers[3] = "2000";
        let qTwelve = Question.new("In which year was Python first released?", qTwelveAnswers, 0);
        let questions[11] = qTwelve;
        return;
    }

    method Question getQuestion(int index) {
        return questions[index];
    }

    // draw the question and its answers on the screen
    method void drawQuestion(Question q) {
        do Screen.setColor(false); // Clear the question box
        do Screen.drawRectangle(36, 42, 401, 128);
        do Screen.setColor(true);  // Reset to drawing color
        do Output.moveCursor(5,5);
        do Output.printString(q.getQuestion());
        do Output.moveCursor(15, 11);
        do Output.printString(q.getAnswer(0));
        do Output.moveCursor(19, 11);
        do Output.printString(q.getAnswer(1));
        do Output.moveCursor(15,37);
        do Output.printString(q.getAnswer(2));
        do Output.moveCursor(19,37);
        do Output.printString(q.getAnswer(3));
        return;
    }

    // get the amount of questions
    method int getSize() {
        return size;
    }

    method void dispose() {
        var int i;

        let i = 0;
        while (i < size) {
            if (~(questions[i] = null)) {
                //do questions[i].dispose();
            }
            let i = i + 1;
        }
        do Memory.deAlloc(this);
        return;
    }
}