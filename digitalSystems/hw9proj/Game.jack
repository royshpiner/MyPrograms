class Game {
    field boolean exit;
    field int place;

    constructor Game new() {
        let exit = false;
        let place = 1;     //  1   2
                          //  3   4

        return this;
    }

    method void dispose() {
        do Memory.deAlloc(this);
        return;
    }


    method void run() {
            var char key;
            do Screen.setColor(true);
            do Screen.drawRectangle(34, 40, 403, 130); // black rectangle
            do Screen.setColor(false);
            do Screen.drawRectangle(36,42,401,128); // inner white rectangle

            do Animation.draw(5088); // top left box   line num *32  start from 16384 = (0,0)

            //distance between top and bottom = 1216
            //distance between left and right = 12
            do markLeftTopBox(); 
            do Animation.draw(5101); // top right box    animation size 192x32
            do Animation.draw(6592); // bottom left box
            do Animation.draw(6605); // bottom right box

        
            while (~exit) { // run the game
                while (key = 0) {
                    let key = Keyboard.keyPressed();
                }
                if (key = 81)  { let exit = true; }     // q key
                if (key = 131) {  // up arrow is pressed
                    if (place = 3){
                        let place = 1;
                        do eraseLeftBottomBox();
                        do markLeftTopBox();
                    }
                    if (place = 4){
                        let place = 2;
                        do eraseRightBottomBox();
                        do markRightTopBox();
                    }
                }   

                if (key = 133) {   // down arrow is pressed
                    if(place = 1){  //if on top left
                        let place = 3;
                        do eraseLeftTopBox();
                        do markLeftBottomBox();
                    }
                    if(place = 2){  // if on top right
                        let place = 4;
                        do eraseRightTopBox();
                        do markRightBottomBox();

                    }
                }   
                if (key = 130) {    // left arrow is pressed
                    if (place = 2){    // if on top ridht
                        let place = 1;
                        do eraseRightTopBox();
                        do markLeftTopBox();
                    }

                    if (place = 4){    //if on bottom right
                        let place = 3;
                        do eraseRightBottomBox();
                        do markLeftBottomBox();
                    }
                              
                } 
                
                if (key = 132) {  // right arrow is pressed
                    if (place = 1){
                        let place = 2;
                        do eraseLeftTopBox();
                        do markRightTopBox();
                    }
                    if (place = 3){
                        let place = 4;
                        do eraseLeftBottomBox();
                        do markRightBottomBox();
                    }
                }   
                while (~(key = 0)) {
                    let key = Keyboard.keyPressed();
                }
            }    
        return;
    }



    method void markLeftTopBox(){
            do Animation.drawTopLeft(4801); // -512-1 2 rows up , 1 left
            do Animation.drawTopRight(4813); // -512-1 2 rows up , 1 left
            do Animation.drawBottomLeft(6017);   
            do Animation.drawBottomRight(6029);   
            return;
    }

    method void eraseLeftTopBox(){
        do Animation.eraseTopLeft(4801);
        do Animation.eraseTopRight(4813);
        do Animation.eraseBottomLeft(6017);
        do Animation.eraseBottomRight(6029);
        return;
    }


    method void markRightTopBox(){
            do Animation.drawTopLeft(4814); // -512-1 2 rows up , 1 left
            do Animation.drawTopRight(4826); // -512-1 2 rows up , 1 left
            do Animation.drawBottomLeft(6030);   
            do Animation.drawBottomRight(6042);   
            return;

    }

    method void eraseRightTopBox(){
        do Animation.eraseTopLeft(4814);
        do Animation.eraseTopRight(4826);
        do Animation.eraseBottomLeft(6030);
        do Animation.eraseBottomRight(6042);
        return;
    }

    method void markLeftBottomBox(){    //  + 9*32 from left top's bottom part
            do Animation.drawTopLeft(6305);  
            do Animation.drawTopRight(6317); // -512-1 2 rows up , 1 left
            do Animation.drawBottomLeft(7521);   
            do Animation.drawBottomRight(7533);   
            return;
    }
     method void eraseLeftBottomBox(){
        do Animation.eraseTopLeft(6305);
        do Animation.eraseTopRight(6317);
        do Animation.eraseBottomLeft(7521);
        do Animation.eraseBottomRight(7533);
        return;
    }

     method void markRightBottomBox(){    //  + 9*32 from left top's bottom part
            do Animation.drawTopLeft(6318);  
            do Animation.drawTopRight(6330); // -512-1 2 rows up , 1 left
            do Animation.drawBottomLeft(7534);   
            do Animation.drawBottomRight(7546);   
            return;
    }

     method void eraseRightBottomBox(){
        do Animation.eraseTopLeft(6318);
        do Animation.eraseTopRight(6330);
        do Animation.eraseBottomLeft(7534);
        do Animation.eraseBottomRight(7546);
        return;
    }






}